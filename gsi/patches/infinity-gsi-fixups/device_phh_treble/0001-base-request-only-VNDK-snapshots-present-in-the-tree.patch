From b1bbb977b3633fc9c62e63dfdd473e4523a85dd4 Mon Sep 17 00:00:00 2001
From: BuildBot <build@local>
Date: Tue, 18 Aug 2026 14:19:26 +0300
Subject: [PATCH] base: request only VNDK snapshots present in the tree

---
 base.mk | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/base.mk b/base.mk
index 5071165..6d54b18 100644
--- a/base.mk
+++ b/base.mk
@@ -253,4 +253,8 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/window_extensions.mk)
 PRODUCT_PRODUCT_PROPERTIES += \
     persist.settings.large_screen_opt.enabled=true
 
-PRODUCT_EXTRA_VNDK_VERSIONS += 30
+# Request only the VNDK snapshots this tree actually carries: board_config.mk
+# hard-errors ("VNDK version N not found") on a missing one, and LineageOS 23's
+# manifest has no prebuilts/vndk/v30.
+PRODUCT_EXTRA_VNDK_VERSIONS += \
+    $(foreach v,28 29 30,$(if $(wildcard prebuilts/vndk/v$(v)/*/Android.bp),$(v)))
-- 
2.53.0

